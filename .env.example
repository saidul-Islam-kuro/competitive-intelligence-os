# --- Database (Supabase Postgres via Prisma) ---------------------------------
# Pooled connection (pgbouncer) — used by the running app.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
# Direct (non-pooled) connection — used by Prisma for migrations.
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- Server -------------------------------------------------------------------
# Local dev only; Vercel ignores this and assigns its own port.
PORT=3000
NODE_ENV=development

# --- Cron ----------------------------------------------------------------------
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` on scheduled
# invocations of /api/cron when this variable is set on the project.
CRON_SECRET=

# --- Public read API (/api/v1/*) -----------------------------------------------
# Phase 1 does not implement the public API yet; this is reserved for it.
# When set, generated API keys must be presented as `x-api-key` or
# `Authorization: Bearer <key>`.
PUBLIC_API_ENABLED=false

# --- Optional AI (BYOK) ---------------------------------------------------------
# Everything below is optional. The product must work with all of these unset.
# Dashboard requests can also supply a provider key per-request instead of
# configuring these; per-request keys are never persisted.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Scraping --------------------------------------------------------------------
# Keep false on Vercel. See README "Vercel scraping limitation".
USE_BROWSER_FALLBACK=false
SCRAPE_TIMEOUT_MS=15000
SCRAPE_MAX_BYTES=5000000
